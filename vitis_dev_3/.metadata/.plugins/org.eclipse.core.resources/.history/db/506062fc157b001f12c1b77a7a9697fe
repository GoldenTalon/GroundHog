#include "xparameters.h"  // Definitions for peripheral base addresses
#include "xil_io.h"       // I/O functions for memory-mapped I/O
#include "sleep.h"        // Sleep functions

#define SPI_BASE_ADDR 0x10000                      // Base address for the AXI Lite SPI module

// SPI Register Offsets
#define SPI_CMD_REG_OFFSET    0x0  // Command Register
#define SPI_DATA_REG_OFFSET   0x4  // Data Register
#define SPI_STATUS_REG_OFFSET 0x8  // Status Register

// SPI Status Register Bits
#define SPI_STATUS_BUSY_MASK  0x01 // Busy flag mask

void send_spi_command(u8 command) {
    // Wait until SPI module is not busy
    while (Xil_In32(SPI_BASE_ADDR + SPI_STATUS_REG_OFFSET) & SPI_STATUS_BUSY_MASK);

    // Write the command to the command register
    Xil_Out32(SPI_BASE_ADDR + SPI_CMD_REG_OFFSET, command);
}

void send_spi_data(u8 data) {
    // Wait until SPI module is not busy
    while (Xil_In32(SPI_BASE_ADDR + SPI_STATUS_REG_OFFSET) & SPI_STATUS_BUSY_MASK);

    // Write the data to the data register
    Xil_Out32(SPI_BASE_ADDR + SPI_DATA_REG_OFFSET, data);
}

void init_display() {
    // Example initialization sequence for ST7735
    // This sequence may vary depending on your specific display and requirements.
    // Refer to the ST7735 datasheet for the correct initialization sequence.

    send_spi_command(0x01); // Software Reset
    sleep(1);               // Delay for reset
    send_spi_command(0x11); // Sleep Out
    sleep(1);
    send_spi_command(0x29); // Display ON
}

int main() {
    u16 led_pattern = 0x0001; // Start with the first LED on

    // Initialize the display
    init_display();

    // Main loop
    while (1) {

        // Example: Update the display with some data
        // Here we send a command and data to the display in each loop iteration
        send_spi_command(0x2A); // Column Address Set
        send_spi_data(0x00);    // Start column high byte
        send_spi_data(0x02);    // Start column low byte
        send_spi_data(0x00);    // End column high byte
        send_spi_data(0x81);    // End column low byte

        send_spi_command(0x2B); // Row Address Set
        send_spi_data(0x00);    // Start row high byte
        send_spi_data(0x01);    // Start row low byte
        send_spi_data(0x00);    // End row high byte
        send_spi_data(0xA0);    // End row low byte

        send_spi_command(0x2C); // Memory Write
        // Send pixel data (example: fill with a color)
        // For simplicity, we'll send the same data multiple times
        for (int i = 0; i < 1000; i++) {
            send_spi_data(0xF8); // Red pixel data high byte
            send_spi_data(0x00); // Red pixel data low byte
        }

        // Delay to slow down the blinking and display updates
        sleep(1); // Delay for 1 second
    }

    return 0;
}
